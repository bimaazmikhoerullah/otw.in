<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    tools:context=".Register">

    <LinearLayout
        android:id="@+id/contentContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="16dp"
        android:paddingBottom="24dp">

        <!-- Main content: scrollable and sized automatically to the form -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/auth_gutter"
            android:paddingEnd="@dimen/auth_gutter">

            <!-- Welcome -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_success"
                android:drawablePadding="6dp"
                android:drawableStart="@drawable/ic_star"
                android:fontFamily="sans-serif-medium"
                android:minHeight="0dp"
                android:text="@string/register_promo"
                android:textColor="@color/green_pressed"
                android:textSize="12sp"
                android:textStyle="bold"
                app:drawableTint="@color/green_pressed" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="sans-serif"
                android:text="@string/register_heading"
                android:textColor="@color/dark_navy"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="sans-serif"
                android:text="@string/register_subtitle"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <!-- Feature strip -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_container_light"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <ImageView
                        android:layout_width="@dimen/auth_feature_icon_size"
                        android:layout_height="@dimen/auth_feature_icon_size"
                        android:background="@drawable/bg_logo_container"
                        android:contentDescription="@string/register_feature_one"
                        android:padding="6dp"
                        android:src="@drawable/ic_shield_check"
                        app:tint="@color/primary" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/register_feature_one"
                        android:textColor="@color/dark_navy"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_container_light"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <ImageView
                        android:layout_width="@dimen/auth_feature_icon_size"
                        android:layout_height="@dimen/auth_feature_icon_size"
                        android:background="@drawable/bg_badge_success"
                        android:contentDescription="@string/register_feature_two"
                        android:padding="6dp"
                        android:src="@drawable/ic_cash"
                        app:tint="@color/secondary_green" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/register_feature_two"
                        android:textColor="@color/dark_navy"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Form card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardRegister"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/auth_section_gap"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="@dimen/auth_card_radius"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Full name -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/register_name_label"
                        android:textColor="@color/dark_navy"
                        android:textSize="14sp" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilName"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:boxBackgroundColor="@color/background_gray"
                        app:boxCornerRadiusBottomEnd="@dimen/auth_component_radius"
                        app:boxCornerRadiusBottomStart="@dimen/auth_component_radius"
                        app:boxCornerRadiusTopEnd="@dimen/auth_component_radius"
                        app:boxCornerRadiusTopStart="@dimen/auth_component_radius"
                        app:boxStrokeColor="@color/box_stroke_states"
                        app:boxStrokeErrorColor="@color/error_color"
                        app:boxStrokeWidth="1dp"
                        app:boxStrokeWidthFocused="2dp"
                        app:errorEnabled="true"
                        app:hintEnabled="false"
                        app:startIconDrawable="@drawable/ic_user"
                        app:startIconTint="@color/text_secondary">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/txtFullName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:autofillHints="name"
                            android:fontFamily="sans-serif"
                            android:hint="@string/register_name_hint_id"
                            android:inputType="textPersonName|textCapWords"
                            android:minHeight="48dp"
                            android:textColor="@color/dark_navy"
                            android:textColorHint="@color/text_hint" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Username -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/auth_field_gap"
                        android:layout_marginBottom="6dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/register_username_label"
                        android:textColor="@color/dark_navy"
                        android:textSize="14sp" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilUsername"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:boxBackgroundColor="@color/background_gray"
                        app:boxCornerRadiusBottomEnd="@dimen/auth_component_radius"
                        app:boxCornerRadiusBottomStart="@dimen/auth_component_radius"
                        app:boxCornerRadiusTopEnd="@dimen/auth_component_radius"
                        app:boxCornerRadiusTopStart="@dimen/auth_component_radius"
                        app:boxStrokeColor="@color/box_stroke_states"
                        app:boxStrokeErrorColor="@color/error_color"
                        app:boxStrokeWidth="1dp"
                        app:boxStrokeWidthFocused="2dp"
                        app:errorEnabled="true"
                        app:helperText="@string/register_username_helper"
                        app:hintEnabled="false"
                        app:startIconDrawable="@drawable/ic_alternate_email"
                        app:startIconTint="@color/text_secondary">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/txtUsername"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:autofillHints="username"
                            android:fontFamily="sans-serif"
                            android:hint="@string/register_username_hint"
                            android:inputType="text|textNoSuggestions"
                            android:maxLines="1"
                            android:minHeight="48dp"
                            android:textColor="@color/dark_navy"
                            android:textColorHint="@color/text_hint" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Phone -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/auth_field_gap"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/register_phone_label"
                            android:textColor="@color/dark_navy"
                            android:textSize="14sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/register_otp_badge"
                            android:textColor="@color/secondary_green"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilPhone"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        app:boxBackgroundColor="@color/background_gray"
                        app:boxCornerRadiusBottomEnd="@dimen/auth_component_radius"
                        app:boxCornerRadiusBottomStart="@dimen/auth_component_radius"
                        app:boxCornerRadiusTopEnd="@dimen/auth_component_radius"
                        app:boxCornerRadiusTopStart="@dimen/auth_component_radius"
                        app:boxStrokeColor="@color/box_stroke_states"
                        app:boxStrokeErrorColor="@color/error_color"
                        app:boxStrokeWidth="1dp"
                        app:boxStrokeWidthFocused="2dp"
                        app:errorEnabled="true"
                        app:hintEnabled="false"
                        app:prefixText="+62"
                        app:prefixTextColor="@color/dark_navy">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/txtPhone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:autofillHints="phone"
                            android:fontFamily="sans-serif"
                            android:hint="@string/register_phone_hint_id"
                            android:inputType="phone"
                            android:minHeight="48dp"
                            android:textColor="@color/dark_navy"
                            android:textColorHint="@color/text_hint" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Email -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/auth_field_gap"
                        android:layout_marginBottom="6dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/register_email_label"
                        android:textColor="@color/dark_navy"
                        android:textSize="14sp" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilEmail"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:boxBackgroundColor="@color/background_gray"
                        app:boxCornerRadiusBottomEnd="@dimen/auth_component_radius"
                        app:boxCornerRadiusBottomStart="@dimen/auth_component_radius"
                        app:boxCornerRadiusTopEnd="@dimen/auth_component_radius"
                        app:boxCornerRadiusTopStart="@dimen/auth_component_radius"
                        app:boxStrokeColor="@color/box_stroke_states"
                        app:boxStrokeErrorColor="@color/error_color"
                        app:boxStrokeWidth="1dp"
                        app:boxStrokeWidthFocused="2dp"
                        app:errorEnabled="true"
                        app:hintEnabled="false"
                        app:startIconDrawable="@drawable/ic_email"
                        app:startIconTint="@color/text_secondary">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/txtEmail"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:autofillHints="emailAddress"
                            android:fontFamily="sans-serif"
                            android:hint="@string/register_email_hint_id"
                            android:inputType="textEmailAddress"
                            android:minHeight="48dp"
                            android:textColor="@color/dark_navy"
                            android:textColorHint="@color/text_hint" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Password -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/auth_field_gap"
                        android:layout_marginBottom="6dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/register_password_label"
                        android:textColor="@color/dark_navy"
                        android:textSize="14sp" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilPassword"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:boxBackgroundColor="@color/background_gray"
                        app:boxCornerRadiusBottomEnd="@dimen/auth_component_radius"
                        app:boxCornerRadiusBottomStart="@dimen/auth_component_radius"
                        app:boxCornerRadiusTopEnd="@dimen/auth_component_radius"
                        app:boxCornerRadiusTopStart="@dimen/auth_component_radius"
                        app:boxStrokeColor="@color/box_stroke_states"
                        app:boxStrokeErrorColor="@color/error_color"
                        app:boxStrokeWidth="1dp"
                        app:boxStrokeWidthFocused="2dp"
                        app:endIconMode="password_toggle"
                        app:endIconTint="@color/text_secondary"
                        app:errorEnabled="true"
                        app:hintEnabled="false"
                        app:startIconDrawable="@drawable/ic_lock"
                        app:startIconTint="@color/text_secondary">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/txtPassword"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:autofillHints="password"
                            android:fontFamily="sans-serif"
                            android:hint="@string/register_password_hint_id"
                            android:inputType="textPassword"
                            android:minHeight="48dp"
                            android:textColor="@color/dark_navy"
                            android:textColorHint="@color/text_hint" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Live password strength meter -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/register_strength_label"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/tvStrengthValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-medium"
                                android:text="@string/strength_empty"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/auth_strength_height"
                            android:layout_marginTop="4dp"
                            android:background="@drawable/bg_strength_track"
                            android:orientation="horizontal">

                            <View
                                android:id="@+id/strengthBar1"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_marginEnd="2dp"
                                android:layout_weight="1"
                                android:background="@drawable/bg_strength_bar" />

                            <View
                                android:id="@+id/strengthBar2"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_marginEnd="2dp"
                                android:layout_weight="1"
                                android:background="@drawable/bg_strength_bar" />

                            <View
                                android:id="@+id/strengthBar3"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:background="@drawable/bg_strength_bar" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Confirm password -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/auth_field_gap"
                        android:layout_marginBottom="6dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/register_confirm_label"
                        android:textColor="@color/dark_navy"
                        android:textSize="14sp" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilConfirmPassword"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:boxBackgroundColor="@color/background_gray"
                        app:boxCornerRadiusBottomEnd="@dimen/auth_component_radius"
                        app:boxCornerRadiusBottomStart="@dimen/auth_component_radius"
                        app:boxCornerRadiusTopEnd="@dimen/auth_component_radius"
                        app:boxCornerRadiusTopStart="@dimen/auth_component_radius"
                        app:boxStrokeColor="@color/box_stroke_states"
                        app:boxStrokeErrorColor="@color/error_color"
                        app:boxStrokeWidth="1dp"
                        app:boxStrokeWidthFocused="2dp"
                        app:endIconMode="password_toggle"
                        app:endIconTint="@color/text_secondary"
                        app:errorEnabled="true"
                        app:hintEnabled="false"
                        app:startIconDrawable="@drawable/ic_lock_reset"
                        app:startIconTint="@color/text_secondary">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/txtConfirmPassword"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:autofillHints="password"
                            android:fontFamily="sans-serif"
                            android:hint="@string/register_confirm_hint_id"
                            android:inputType="textPassword"
                            android:minHeight="48dp"
                            android:textColor="@color/dark_navy"
                            android:textColorHint="@color/text_hint" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:id="@+id/tvForgotPassword"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:layout_marginTop="4dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:minHeight="0dp"
                        android:text="@string/login_forgot_password_id"
                        android:textColor="@color/primary"
                        android:textSize="12sp" />

                    <!-- Terms -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <CheckBox
                            android:id="@+id/checkboxTerms"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:button="@drawable/bg_checkbox_selector"
                            android:minHeight="48dp"
                            android:minWidth="48dp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/register_terms_agreement"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- Actions -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRegister"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/auth_primary_button_height"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_button_login"
                        android:fontFamily="sans-serif-medium"
                        android:minHeight="0dp"
                        android:text="@string/register_submit"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        android:textSize="15sp"
                        app:backgroundTint="@null"
                        app:cornerRadius="@dimen/auth_component_radius"
                        app:icon="@drawable/ic_arrow_forward"
                        app:iconGravity="textEnd"
                        app:iconPadding="8dp"
                        app:iconTint="@color/white" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1"
                            android:background="@color/border_gray" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_marginEnd="12dp"
                            android:text="@string/register_or"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1"
                            android:background="@color/border_gray" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnGoogle"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/auth_secondary_button_height"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/bg_button_google_outline"
                        android:fontFamily="sans-serif-medium"
                        android:minHeight="0dp"
                        android:text="@string/register_google"
                        android:textAllCaps="false"
                        android:textColor="@color/dark_navy"
                        android:textSize="13sp"
                        app:backgroundTint="@null"
                        app:cornerRadius="@dimen/auth_component_radius"
                        app:icon="@drawable/ic_google"
                        app:iconPadding="12dp"
                        app:iconTint="@null" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Footer -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/auth_section_gap"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="0dp"
                    android:text="@string/register_login_prompt"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvLoginLink"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="sans-serif-medium"
                    android:minHeight="0dp"
                    android:text="@string/register_login_link_id"
                    android:textColor="@color/primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawablePadding="4dp"
                    android:drawableStart="@drawable/ic_lock"
                    android:minHeight="0dp"
                    android:text="@string/trust_ssl"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    app:drawableTint="@color/text_secondary" />

                <View
                    android:layout_width="4dp"
                    android:layout_height="4dp"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/bg_strength_track" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawablePadding="4dp"
                    android:drawableStart="@drawable/ic_shield"
                    android:minHeight="0dp"
                    android:text="@string/trust_privacy"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    app:drawableTint="@color/text_secondary" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
