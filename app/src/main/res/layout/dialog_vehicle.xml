<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="8dp"
        android:paddingEnd="20dp"
        android:paddingBottom="8dp">

        <ImageView
            android:id="@+id/imgVehiclePreview"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:background="@drawable/bg_home_image_placeholder"
            android:contentDescription="@string/admin_field_image_url"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_car" />

        <Button
            android:id="@+id/btnPickImage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:text="@string/admin_image_pick"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/txtVehicleBrand"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/admin_field_brand"
            android:inputType="text"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/txtVehicleName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/admin_field_name"
            android:inputType="text"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/admin_field_category"
            android:textColor="@color/home_on_surface_variant"
            android:textSize="11sp" />

        <Spinner
            android:id="@+id/spinnerCategory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_home_container" />

        <EditText
            android:id="@+id/txtVehicleSeats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/admin_field_seats"
            android:inputType="text"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/txtVehicleTransmission"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/admin_field_transmission"
            android:inputType="text"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/txtVehicleFeature"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/admin_field_feature"
            android:inputType="text"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/txtVehiclePrice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/admin_field_price"
            android:inputType="number"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/txtVehicleRating"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/admin_field_rating"
            android:inputType="numberDecimal"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/txtVehicleReviews"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/admin_field_reviews"
            android:inputType="number"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/txtVehicleBadge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/admin_field_badge"
            android:inputType="text"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/admin_field_badge_type"
            android:textColor="@color/home_on_surface_variant"
            android:textSize="11sp" />

        <Spinner
            android:id="@+id/spinnerBadgeType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_home_container" />

        <EditText
            android:id="@+id/txtVehicleImageUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/admin_field_image_url"
            android:inputType="textUri"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/admin_image_hint"
            android:textColor="@color/home_on_surface_variant"
            android:textSize="10sp" />

        <CheckBox
            android:id="@+id/chkVehicleActive"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/admin_field_active"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
