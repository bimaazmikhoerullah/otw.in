<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_home_card"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvAdminOrderCustomer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/home_on_surface"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="Nama Pelanggan" />

        <TextView
            android:id="@+id/tvAdminOrderStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_home_badge_green"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:textColor="@color/home_secondary"
            android:textSize="10sp"
            android:textStyle="bold"
            tools:text="Diproses" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvAdminOrderVehicle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/home_on_surface_variant"
        android:textSize="12sp"
        tools:text="Armada • 27 – 29 Nov" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvAdminOrderMode"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/home_on_surface_variant"
            android:textSize="11sp"
            tools:text="Lepas Kunci" />

        <TextView
            android:id="@+id/tvAdminOrderTotal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/home_primary"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="Rp 1.000.000" />
    </LinearLayout>

    <TextView
        android:id="@+id/btnAdminOrderDone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_home_button_secondary"
        android:gravity="center"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="7dp"
        android:paddingBottom="7dp"
        android:text="@string/admin_mark_done"
        android:textColor="@color/home_primary"
        android:textSize="11sp"
        android:textStyle="bold" />
</LinearLayout>
