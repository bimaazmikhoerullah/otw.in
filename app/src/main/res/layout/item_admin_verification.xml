<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_home_card"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvVerificationInitial"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_home_surface_low"
            android:gravity="center"
            android:textColor="@color/home_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            tools:text="A" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvVerificationName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:textColor="@color/home_on_surface"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="Nama Pelanggan" />

                <TextView
                    android:id="@+id/tvVerificationCode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_home_surface_low"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:textColor="@color/home_on_surface_variant"
                    android:textSize="10sp"
                    tools:text="#STM-00001" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvVerificationVehicle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/home_on_surface_variant"
                android:textSize="12sp"
                tools:text="Armada • 27 – 29 Nov" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvVerificationMode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_home_badge_green"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:textColor="@color/home_secondary"
            android:textSize="10sp"
            android:textStyle="bold"
            tools:text="Lepas Kunci" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_home_verified"
                app:tint="@color/home_amber" />

            <TextView
                android:id="@+id/tvVerificationDoc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="@string/admin_doc_pending"
                android:textColor="@color/home_on_surface_variant"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnVerificationCheck"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_home_button_primary"
            android:gravity="center"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="@string/admin_check"
            android:textColor="@color/home_surface"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
